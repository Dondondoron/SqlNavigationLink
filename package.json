{
  "name": "sql-nav-link",
  "displayName": "sql-nav-link",
  "description": "API for interactive Context in SQLMESH Project",
  "publisher": "Dondondoron",
  "version": "0.0.8",
  "license": "GPL-3.0",
  "icon": "./media/thumb.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dondondoron/Uibi"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:sqlmesh-localite-functions-view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sql-nav-link.addPath",
        "title": "Add Path to Sql Navigation",
        "icon": "$(add)"
      },
      {
        "command": "sql-nav-link.changePathType",
        "title": "Change SQL Path type",
        "icon": "$(split-vertical)"
      },
      {
        "command": "sql-nav-link.removePath",
        "title": "Remove Path",
        "icon": "$(trash)"
      },
      {
        "command": "sql-nav-link.parsePaths",
        "title": "Parse current Paths for SQL Models",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sql-nav-link-sidebar",
          "title": "SQL Nav Link",
          "icon": "./media/sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "sql-nav-link-panel",
          "title": "SQL Nav Link",
          "icon": "./media/sidebar.svg"
        }
      ]
    },
    "views": {
      "sql-nav-link-sidebar": [
        {
          "type": "webview",
          "id": "sql-nav-link.parseView", 
          "name": "SQL Parsing"
        },
        {
          "type": "tree",
          "id": "sql-nav-link.modelTree", 
          "name": "SQL Models"
        }
      ],
      "sql-nav-link-panel": [
        {
          "type": "webview",
          "id": "sql-nav-link-panel.Lineage", 
          "name": "SQL Folder Paths"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sql-nav-link.addPath",
          "when": "view == sqlNavLinkPaths",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sql-nav-link.removePath",
          "when": "view == sqlNavLinkPaths",
          "group": "inline"
        },
        {
          "command": "sql-nav-link.changePathType",
          "when": "view == sqlNavLinkPaths",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "SQL Navigation Link",
      "properties": {
        "Dondondoron.sql-nav-link.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Enter the path to your python environment including sqlmesh or sqlglot + jinja"
        },
        "Dondondoron.sql-nav-link.autoContext": {
          "type": "boolean",
          "default": false,
          "description": "Whether to automatically load context (default false)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "eventsource": "^2.0.2",
    "watch": "^1.0.2"
  },
  "extensionDependencies": [
    "ms-python.python"
  ]
}